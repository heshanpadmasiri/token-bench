<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Token Bench Report</title>
  <style>
    :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #172033; background: #f4f6fa; }
    body { margin: 0; }
    main { max-width: 1280px; margin: 0 auto; padding: 2rem; }
    h1 { margin-bottom: .25rem; }
    h2 { margin-top: 0; }
    .muted { color: #667085; }
    .warning { padding: .9rem 1rem; margin: 1rem 0; border: 1px solid #f4b740; border-radius: .5rem; color: #7a4d00; background: #fff8e6; font-weight: 650; }
    .task { margin: 2rem 0; padding: 1.5rem; border-radius: .75rem; background: white; box-shadow: 0 1px 5px #17203318; }
    .charts { display: grid; grid-template-columns: 1fr; gap: 1rem; }
    figure { min-width: 0; margin: 0; padding: 1rem; border: 1px solid #e5e9f0; border-radius: .5rem; }
    figcaption { font-size: 1.1rem; font-weight: 700; }
    .legend { margin-top: .35rem; color: #667085; font-size: .9rem; }
    svg { display: block; width: 100%; margin-top: .5rem; overflow: visible; }
    .language { font-size: 22px; font-weight: 650; fill: #344054; }
    .whisker { stroke: #667085; stroke-width: 3; }
    .quartile { fill: #dce4ff; stroke: #5577e5; stroke-width: 3; }
    .median { stroke: #172033; stroke-width: 4; }
    .deviation { stroke: #e58a2b; stroke-width: 5; }
    .mean { fill: #5577e5; stroke: white; stroke-width: 2; }
    .value { font-size: 18px; font-weight: 650; fill: #172033; }
    .unavailable { font-size: 18px; fill: #667085; }
    table { width: 100%; margin-top: 1.5rem; border-collapse: collapse; }
    th, td { padding: .65rem; border-bottom: 1px solid #e5e9f0; text-align: right; }
    th:first-child, td:first-child { text-align: left; }
    th { color: #475467; font-size: .85rem; }
  </style>
</head>
<body>
<main>
  <h1>Token Bench Report</h1>
  <div class="muted">Harness: <strong>{{.Harness}}</strong> · {{.TotalRuns}} runs</div>
  {{if .FailedRuns}}<div class="warning">Warning: {{.FailedRuns}} of {{.TotalRuns}} runs failed. Failed runs are excluded from all averages.</div>{{end}}

  {{range .Tasks}}
  <section class="task">
    <h2>{{.Name}}</h2>
    <div class="muted">{{.TotalRuns}} runs across {{len .Languages}} languages; averages use successful runs only.</div>
    {{if .NoSuccesses}}<div class="warning">Warning: this task has no successful runs, so averages are unavailable.</div>{{else if .FailedRuns}}<div class="warning">Warning: {{.FailedRuns}} runs failed for this task and are excluded from averages.</div>{{end}}

    <div class="charts">
      {{range .Charts}}
      <figure>
        <figcaption>{{.Name}}</figcaption>
        <div class="legend">Whiskers: range · box: Q1–Q3 · dark line: median · dot: mean · orange line: mean ± 1σ</div>
        <svg viewBox="0 0 1200 {{.Height}}" role="img" aria-label="{{.Name}} distribution by language">
          {{range .Boxes}}
          <g transform="translate(0,{{.Y}})">
            <text class="language" x="0" y="0" dominant-baseline="middle">{{.Language}}</text>
            {{if .Available}}
            <line class="whisker" x1="{{printf "%.2f" .MinimumX}}" x2="{{printf "%.2f" .MaximumX}}" y1="0" y2="0"></line>
            <line class="whisker" x1="{{printf "%.2f" .MinimumX}}" x2="{{printf "%.2f" .MinimumX}}" y1="-11" y2="11"></line>
            <line class="whisker" x1="{{printf "%.2f" .MaximumX}}" x2="{{printf "%.2f" .MaximumX}}" y1="-11" y2="11"></line>
            <rect class="quartile" x="{{printf "%.2f" .Q1X}}" y="-17" width="{{printf "%.2f" .BoxWidth}}" height="34" rx="3"></rect>
            <line class="median" x1="{{printf "%.2f" .MedianX}}" x2="{{printf "%.2f" .MedianX}}" y1="-18" y2="18"></line>
            <line class="deviation" x1="{{printf "%.2f" .DeviationStartX}}" x2="{{printf "%.2f" .DeviationEndX}}" y1="24" y2="24"></line>
            <circle class="mean" cx="{{printf "%.2f" .MeanX}}" cy="0" r="7"></circle>
            <text class="value" x="885" y="0" dominant-baseline="middle">median {{printf "%.1f" .Median}} · σ {{printf "%.1f" .Deviation}}</text>
            {{else}}
            <text class="unavailable" x="210" y="0" dominant-baseline="middle">No successful runs</text>
            {{end}}
          </g>
          {{end}}
        </svg>
      </figure>
      {{end}}
    </div>

    <table>
      <thead><tr><th>Language</th><th>Successful</th><th>Failed</th><th>Pass rate</th><th>Avg fixes</th><th>Avg input</th><th>Avg output</th><th>Avg total</th></tr></thead>
      <tbody>
        {{range .Languages}}<tr>
          <td>{{.Name}}</td><td>{{.Successful}}</td><td>{{.Failed}}</td><td>{{printf "%.1f" .PassRate}}%</td>
          <td>{{printf "%.1f" .AvgCorrections}}</td><td>{{printf "%.1f" .AvgInput}}</td><td>{{printf "%.1f" .AvgOutput}}</td><td>{{printf "%.1f" .AvgTotal}}</td>
        </tr>{{end}}
      </tbody>
    </table>
  </section>
  {{end}}
</main>
</body>
</html>
